# Copy this file to .env and fill in your key.
# Without a key the app still runs, in offline mode (rule-based audits, hashing embeddings).
GEMINI_API_KEY=

# Optional overrides
# HINDSIGHT_PROVIDER=auto                    # auto | gemini | offline
# HINDSIGHT_MODEL=gemini-flash-latest
# HINDSIGHT_EMBED_MODEL=gemini-embedding-001
# HINDSIGHT_EMBED_DIM=768
# HINDSIGHT_LLM_TIMEOUT_S=30
# HINDSIGHT_LLM_RETRIES=2
# HINDSIGHT_SEED_DEMO=true
